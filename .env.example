# Server-only. Required for production; use a unique random value with 32+ characters.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
STUDIO_SESSION_SECRET=replace-with-a-long-random-secret
# Optional: set this to a mounted, persistent shared directory when running multiple instances.
# STUDIO_SESSION_DIR=/var/lib/liorandb-studio/sessions
